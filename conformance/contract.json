{
  "log": {
    "correlation_id_field": "correlation_id",
    "trace_fields": [
      "trace_id",
      "span_id"
    ],
    "full_tracebacks_environment_variable": "AUDITRY_FULL_TRACEBACKS"
  },
  "strict": {
    "environment_variable": "AUDITRY_STRICT",
    "non_production_environments": [
      "ci",
      "dev",
      "development",
      "local",
      "plat-sandbox",
      "qa",
      "sandbox",
      "stage",
      "staging",
      "test",
      "testing"
    ],
    "non_production_prefixes": [
      "local-",
      "dev-"
    ]
  },
  "redaction": {
    "patterns": [
      "password",
      "passwd",
      "token",
      "api_key",
      "apikey",
      "secret",
      "ssn",
      "social_security_number",
      "credit_card",
      "creditcard",
      "authorization",
      "x-api-key",
      "cookie",
      "set-cookie",
      "jwt",
      "bearer",
      "otp",
      "one_time_password",
      "access_key",
      "private_key",
      "signature",
      "credential",
      "x-auth",
      "farsight-auth",
      "x-amz-security-token",
      "proxy-authorization",
      "csrf",
      "xsrf"
    ],
    "allowlist": [
      "prompt_tokens",
      "completion_tokens",
      "total_tokens",
      "prompt_tokens_details",
      "completion_tokens_details",
      "cached_tokens",
      "cache_write_tokens",
      "reasoning_tokens",
      "audio_tokens",
      "text_tokens",
      "image_tokens",
      "accepted_prediction_tokens",
      "rejected_prediction_tokens",
      "input_tokens",
      "output_tokens",
      "cache_creation_input_tokens",
      "cache_read_input_tokens",
      "ephemeral_5m_input_tokens",
      "ephemeral_1h_input_tokens",
      "output_tokens_details",
      "thinking_tokens",
      "prompt_token_count",
      "candidates_token_count",
      "cached_content_token_count",
      "thoughts_token_count",
      "tool_use_prompt_token_count",
      "total_token_count",
      "candidates_tokens_details",
      "cache_tokens_details",
      "tool_use_prompt_tokens_details",
      "token_count",
      "max_tokens",
      "max_completion_tokens",
      "max_output_tokens",
      "token_type",
      "token_type_hint"
    ],
    "marker": "[REDACTED]"
  },
  "metrics": {
    "forbidden_dimension_patterns": [
      "userid",
      "username",
      "useremail",
      "email",
      "filename",
      "filepath",
      "objectkey",
      "document",
      "prompt",
      "completion",
      "message",
      "title",
      "query",
      "ticker",
      "ssn",
      "phone",
      "address",
      "firstname",
      "lastname",
      "fullname"
    ],
    "max_dimensions": 8,
    "max_dimension_value_length": 128,
    "max_keys_per_dimension_set": 30,
    "reserved_record_keys": [
      "_aws",
      "correlation_id",
      "environment",
      "event",
      "exc_info",
      "level",
      "message",
      "service",
      "span_id",
      "timestamp",
      "trace_id",
      "version"
    ]
  }
}
